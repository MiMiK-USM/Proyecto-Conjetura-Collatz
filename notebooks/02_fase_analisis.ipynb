import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import pearsonr

def secuencia_collatz(n):
    trayectoria = [n]
    while n > 1:
        if n % 2 == 0:
            n = n // 2
        else:
            n = 3 * n + 1
        trayectoria.append(n)
    return trayectoria

N_analisis = 100000
T_arr = np.zeros(N_analisis)
A_arr = np.zeros(N_analisis)

for i in range(1, N_analisis + 1):
    seq = secuencia_collatz(i)
    T_arr[i-1] = len(seq) - 1
    A_arr[i-1] = max(seq)

print(f"--- Estadísticas para N = {N_analisis} ---")
print(f"Media: {np.mean(T_arr):.2f}")
print(f"Mediana: {np.median(T_arr)}")
print(f"Desviación Estándar: {np.std(T_arr):.2f}")
print(f"Percentil 95: {np.percentile(T_arr, 95)}")

corr, _ = pearsonr(T_arr, np.log10(A_arr))
plt.figure(figsize=(7, 5))
plt.scatter(T_arr, A_arr, s=0.5, alpha=0.2, color='purple')
plt.yscale('log')
plt.title(f'Relación $T(n)$ vs $A(n)$ (Correlación con log(A) = {corr:.3f})')
plt.xlabel('$T(n)$')
plt.ylabel('$A(n)$ (Escala log)')
plt.grid(True)
plt.show()

n_vals = np.arange(1, N_analisis + 1)
pares = T_arr[n_vals % 2 == 0]
impares = T_arr[n_vals % 2 != 0]
multiplos_3 = T_arr[n_vals % 3 == 0]

plt.figure(figsize=(8, 5))
plt.boxplot([pares, impares, multiplos_3], labels=['Pares', 'Impares', 'Múltiplos de 3'])
plt.title('Comparación de $T(n)$ según propiedades de $n$')
plt.ylabel('$T(n)$')
plt.grid(True)
plt.show()

records_n = []
records_T = []
max_t_actual = -1

for i in range(1, N_analisis + 1):
    if T_arr[i-1] > max_t_actual:
        max_t_actual = T_arr[i-1]
        records_n.append(i)
        records_T.append(int(max_t_actual))
        if len(records_n) == 20:
            break

print("\n--- Primeros 20 Récords de Tiempo de Vuelo ---")
for r_n, r_t in zip(records_n, records_T):
    print(f"n = {r_n} -> Nuevo Récord T(n) = {r_t}")
