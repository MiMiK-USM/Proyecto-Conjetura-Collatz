import matplotlib.pyplot as plt

def secuencia_original(n):
    seq = [n]
    while n > 1:
        n = n // 2 if n % 2 == 0 else 3 * n + 1
        seq.append(n)
    return seq

def variante_3n_menos_1(n, max_pasos=200):
    seq = [n]
    paso = 0
    while n != 1 and paso < max_pasos:
        n = n // 2 if n % 2 == 0 else 3 * n - 1
        seq.append(n)
        paso += 1
        if len(seq) > 20 and seq[-1] in seq[:-2]:
            break
    return seq

def variante_5n_mas_1(n, max_pasos=200):
    seq = [n]
    paso = 0
    while n != 1 and paso < max_pasos:
        n = n // 2 if n % 2 == 0 else 5 * n + 1
        seq.append(n)
        paso += 1
        if len(seq) > 20 and seq[-1] in seq[:-2]:
            break
    return seq

plt.figure(figsize=(12, 6))
plt.plot(secuencia_original(7), label='Original (3n+1) -> Llega a 1', color='blue', marker='o')
plt.plot(variante_3n_menos_1(7), label='Variante (3n-1) -> Cae en bucle', color='green', marker='s')
plt.plot(variante_5n_mas_1(7), label='Variante (5n+1) -> Diverge / Bucle largo', color='red', marker='^')

plt.title('Comparación de Comportamiento de Variantes con $n = 7$')
plt.xlabel('Pasos')
plt.ylabel('Valor de $n$ (Escala log)')
plt.yscale('log')
plt.legend()
plt.grid(True, which="both", ls="--")
plt.show()
