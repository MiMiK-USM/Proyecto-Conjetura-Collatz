import matplotlib.pyplot as plt
import numpy as np

# 1. Definición de la función de Collatz que calcula la trayectoria completa
def secuencia_collatz(n):
    trayectoria = [n]
    while n > 1:
        if n % 2 == 0:
            n = n // 2
        else:
            n = 3 * n + 1
        trayectoria.append(n)
    return trayectoria

# 2. Función para obtener las métricas de un rango de números (hasta N)
def calcular_metricas_collatz(N):
    tiempos_vuelo = []
    altitudes_maximas = []
    
    for i in range(1, N + 1):
        trayectoria = secuencia_collatz(i)
        # El tiempo de vuelo es el total de pasos (largo de la lista menos 1)
        tiempos_vuelo.append(len(trayectoria) - 1)
        # La altitud máxima es el valor más alto alcanzado en la secuencia
        altitudes_maximas.append(max(trayectoria))
        
    return np.array(tiempos_vuelo), np.array(altitudes_maximas)

# Calculamos las métricas obligatorias para los primeros 10,000 números
n_valores = np.arange(1, 10001)
tiempos, altitudes = calcular_metricas_collatz(10000)

print("¡Estructura base lista! Ya calculamos los tiempos y altitudes para N=10000.")
