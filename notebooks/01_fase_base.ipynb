import numpy as np
import matplotlib.pyplot as plt

def secuencia_collatz(n):
    trayectoria = [n]
    while n > 1:
        if n % 2 == 0:
            n = n // 2
        else:
            n = 3 * n + 1
        trayectoria.append(n)
    return trayectoria

print("Trayectoria del 27:", secuencia_collatz(27))

N_max = 10000
tiempos_vuelo = []
altitudes_maximas = []

for i in range(1, N_max + 1):
    t = secuencia_collatz(i)
    tiempos_vuelo.append(len(t) - 1)
    altitudes_maximas.append(max(t))

fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))

ax1.scatter(range(1, N_max + 1), tiempos_vuelo, s=1, alpha=0.5, color='blue')
ax1.set_title('Tiempo de vuelo $T(n)$ vs $n$')
ax1.set_xlabel('$n$')
ax1.set_ylabel('$T(n)$')
ax1.grid(True)

ax2.hist(tiempos_vuelo, bins=50, color='skyblue', edgecolor='black', alpha=0.7)
ax2.set_title('Distribución de los Tiempos de Vuelo')
ax2.set_xlabel('$T(n)$')
ax2.set_ylabel('Frecuencia')
ax2.grid(True)
plt.show()

tiempos_np = np.array(tiempos_vuelo)
altitudes_np = np.array(altitudes_maximas)
top_10_n = np.argsort(tiempos_np)[-10:][::-1] + 1

print("\n--- TOP 10 VALORES CON MAYOR TIEMPO DE VUELO ---")
for n in top_10_n:
    print(f"n = {n} -> Tiempo de vuelo: {tiempos_np[n-1]}, Altitud máxima: {altitudes_np[n-1]}")
